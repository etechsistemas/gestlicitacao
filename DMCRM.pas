procedure TFDMCRM.QConCliPoten3AfterScroll(DataSet: TDataSet);
begin
    tclifullow.Close;
    tclifullow.params.ParamByName('CODCLI').AsInteger := qconcliPoten3codigo.value;
    tclifullow.params.ParamByName('TIPO').AsString := 'CONTATO';
    tclifullow.open;

    TCliPotenCont.Close;
    TCliPotenCont.Params.ParamByName('codclipoten').AsInteger := qconcliPoten3codigo.value;
    TCliPotenCont.Params.ParamByName('codusu').AsInteger := qconcliPoten3codUSU.value;
    TCliPotenCont.Open;


end;

procedure TFDMCRM.QConCliPoten3CalcFields(DataSet: TDataSet);
begin
    if QConCliPoten3PESSOA.Value = 'FISICA' then
    begin
       QConCliPoten3cpfcnpj.Value := QConCliPoten3CPF.Value;
       QConCliPoten3inscrg.Value := QConCliPoten3RG.Value;
    end
    else
    begin
       QConCliPoten3cpfcnpj.Value := QConCliPoten3CNPJ.Value;
       QConCliPoten3inscrg.Value := QConCliPoten3INSCEST.Value;
    end;
end;

procedure TFDMCRM.QConCliPoten3DATAALTGetText(Sender: TField; var Text: string;
  DisplayText: Boolean);
var a : TStringList;
begin
  if not QConCliPoten3DATAALT.IsNull then
  begin
    a := Split(QConCliPoten3DATAALT.AsString,' ');
    text := a[0];
  end;
end;

