uses DMSistema, ubiblio, variants, ConEmpresa, Principal;
{$R *.dfm}

procedure TFDM.QConCondPagAfterScroll(DataSet: TDataSet);
begin
{  TParcelas.Close;
  TParcelas.Params.ParamByName('CONDPAG').AsInteger := QConCondPagCODIGO.Value;
  TParcelas.Open;

  if TCondPag.Active then
  begin
    TCondPag.Locate('CODIGO',QConCondPagCODIGO.Value,[]);
  end;}

end;

procedure TFDM.QConEmpresaBeforeGetRecords(Sender: TObject;
  var OwnerData: OleVariant);
begin
   if (ChecaForm(FConEmpresa)) and (FConEmpresa.sql <> '') then
   begin
     OwnerData := VarArrayOf([FConEmpresa.sql]);
   end;
end;

procedure TFDM.QEmpresaPesqBeforeGetRecords(Sender: TObject;
  var OwnerData: OleVariant);
begin
   if (ChecaForm(FPrincipal)) and (FPrincipal.sqlemp <> '') then
   begin
     OwnerData := VarArrayOf([Fprincipal.sqlemp]);
   end;
end;

procedure TFDM.TCondPagAfterScroll(DataSet: TDataSet);
begin
  TParcelas.Close;
  TParcelas.Params.ParamByName('CONDPAG').AsInteger := TCondPagCODIGO.Value;
  TParcelas.Open;
end;

procedure TFDM.TCondPagReconcileError(DataSet: TCustomClientDataSet;
  E: EReconcileError; UpdateKind: TUpdateKind; var Action: TReconcileAction);
begin
  Action := raCancel;
  raise exception.create(E.message);
end;

procedure TFDM.TParcelasReconcileError(DataSet: TCustomClientDataSet;
  E: EReconcileError; UpdateKind: TUpdateKind; var Action: TReconcileAction);
begin
  Action := raCancel;
  raise exception.create(E.message);
end;

procedure TFDM.TRelCustItemAfterScroll(DataSet: TDataSet);
begin
    fdm.TRelCustItemIt.Close;
    fdm.TRelCustItemIt.Params.ParamByName('FORM').AsString := fdm.TRelCustItemFORM.Value;
    fdm.TRelCustItemIt.Params.ParamByName('TABELA').AsInteger := fdm.TRelCustItemTABELA.Value;
    fdm.TRelCustItemIt.Params.ParamByName('REL').AsInteger := fdm.TRelCustItemREL.Value;
    fdm.TRelCustItemIt.Open;
end;

procedure TFDM.TServicoDATAGetText(Sender: TField; var Text: string;
  DisplayText: Boolean);
var
  a: TStringList;
begin
  if not TServicoDATA.IsNull then
  begin
    a := Split(TServicoDATA.AsString, ' ');
    Text := a[0];
  end;
end;

end.
