procedure TFDMGerLicitacao.QConProcessoLicFinancCalcFields(DataSet: TDataSet);
begin
    QConProcessoLicFinancsaldo.value := QConProcessoLicFinancVLRCOMISSAO.Value - QConProcessoLicFinancVALOR.value;


    QConProcessoLicFinancsaldocontrato.value := QConProcessoLicFinancVALORRESULTADO.Value - QConProcessoLicFinancVALORCONTRATOLIC.value;

    if (QConProcessoLicFinancVALORCONTRATOLIC.value > 0 ) and ( QConProcessoLicFinancVALORRESULTADO.Value > 0) then
    begin
      QConProcessoLicFinancpercpago.value := (QConProcessoLicFinancVALORCONTRATOLIC.value / QConProcessoLicFinancVALORRESULTADO.Value) * 100;
    end
    else
    begin
      QConProcessoLicFinancpercpago.value := 0;
    end;
end;

